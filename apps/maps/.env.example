# Gateway origin that serves /w/<slug>/style.json, tiles, Overpass, OSM API 0.6.
# Production: https://mcp.spellkave.com
# Local: http://127.0.0.1:8080 (or the port from the player-mcp dev recipe)
VITE_SPELLKAVE_GATEWAY_URL=https://mcp.spellkave.com

# Base URL of the published spectator feed (index.json). Unset ⇒ public/demo-data sample.
VITE_SPELLKAVE_PUBLIC_SITE_URL=

# Account API origin (optional). Maps is a static SPA so this is a direct
# browser call, not Play's Worker proxy. Unset ⇒ https://api.spellkave.com.
# Hosted maps.spellkave.com CORS is tracked separately (sk-jay0.5.13).
# VITE_SPELLKAVE_API_URL=https://api.spellkave.com

# Shared SpacetimeDB play host for seat claim + "my seat" marker.
# Local node example: ws://127.0.0.1:3000
VITE_SPELLKAVE_PLAY_URL=

# WorkOS AuthKit public SPA client (no secret). Same values as apps/website.
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_ISSUER=https://<tenant>.authkit.app
# VITE_SPELLKAVE_LOGIN_ORIGIN=http://127.0.0.1:18081  # login site for sign-out; no default; required for every non-dev build

# DEV-only: absolute path to a play-stage / operator token file (read by vite.config).
# Dead in production builds (import.meta.env.DEV === false; define inject skipped).
# VITE_SPELLKAVE_DEV_TOKEN_FILE=/abs/path/to/token
# VITE_SPELLKAVE_DEV_DB=spellkave-dev
# When DEV_DB is set, Vite remaps catalog worlds to that local database and
# does not call the hosted Account API.
