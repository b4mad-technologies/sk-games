		"@spellkave/tool-contracts": "0.1.2",
		"@spellkave/ui": "0.1.0",
		"svelte": "^5.46.4",
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.12.4",
		"jsdom": "^26.1.0",
		"svelte-check": "^4.7.1",
