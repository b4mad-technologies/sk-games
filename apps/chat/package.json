{
	"name": "@spellkave/chat",
	"version": "0.0.0",
	"private": true,
	"description": "chat.spellkave.com — in-browser chat player with WorkOS login.",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1 --port 5184",
