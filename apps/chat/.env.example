# WorkOS AuthKit public SPA client (no secret). Never put WORKOS_API_KEY here.
# Unset client id or issuer ⇒ the app fails closed ("this page is not configured");
# there is NO built-in default issuer. Same values as apps/account.
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_ISSUER=https://<tenant>.authkit.app
# VITE_SPELLKAVE_LOGIN_ORIGIN=http://127.0.0.1:18081  # login site for sign-out; no default; required for every non-dev build

# Player MCP Streamable HTTP endpoint (also the RFC 8707 token `aud` / resource
# when the value is an absolute URL).
# Default: https://mcp.spellkave.com/mcp
# Point at a local player-mcp gateway only when that gateway is served over HTTPS
# (an https://chat page cannot call http://localhost — mixed content) and its
# SPELLKAVE_MCP_ALLOWED_ORIGIN_HOSTNAMES include this page's hostname
# (localhost is already on the default list; chat.spellkave.com is added on the deployment stack).
# VITE_SPELLKAVE_MCP_URL=https://mcp.spellkave.com/mcp

# Same-origin Vite proxy to a LOCAL player-mcp (tailnet preview). The local
# gateway listens on loopback but checks Host + JWT aud against mcp.spellkave.com:
# SPELLKAVE_MCP_DEV_PROXY_TARGET=http://127.0.0.1:8087
# SPELLKAVE_MCP_DEV_PROXY_HOST=mcp.spellkave.com
# VITE_SPELLKAVE_MCP_URL=/mcp
# Leave VITE_SPELLKAVE_MCP_RESOURCE unset so aud stays https://mcp.spellkave.com/mcp.
