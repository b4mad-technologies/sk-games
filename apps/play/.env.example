# Base URL of the published spectator feed (index.json). Unset ⇒ public/demo-data.
VITE_SPELLKAVE_PUBLIC_SITE_URL=

# Public documentation origin for the static reference vocabulary. Unset ⇒ https://spellkave.com.
VITE_SPELLKAVE_DOCS_URL=

# Account API base (ADR-0107). Seats / claim / release. Default https://api.spellkave.com.
VITE_SPELLKAVE_API_URL=

# SpacetimeDB origin the browser connects to. Unset ⇒ the page's own origin.
VITE_SPELLKAVE_WORLD_URL=

# Gateway origin for the map tile's canvas (@spellkave/map-canvas): the
# /w/<slug>/style.json and tile routes it mounts at the tile's stage level
# (the sk-jay0.1.8.1 whole-world exception, apps/play/CLAUDE.md). Also the
# origin src/lib/feedback.ts posts tools/call spellkave_feedback to
# (<gatewayOrigin>/mcp) — unset, Send feedback opens an unavailable explanation.
# Optional — unset or invalid degrades the
# map tile to its own blocked state rather than failing the app closed.
# .github/workflows/play.yml's hosted Build step sets this from the repo
# variable SPELLKAVE_GATEWAY_URL, defaulting to https://mcp.spellkave.com
# when that variable is unset (sk-jay0.7.45; same pattern as maps.yml).
VITE_SPELLKAVE_GATEWAY_URL=

# Set false when the configured gateway serves only maps/art. The local play
# recipes default this to false; hosted builds preserve feedback by default.
# Set true locally only with a feedback-capable gateway for the staged seat.
VITE_SPELLKAVE_FEEDBACK_ENABLED=

# Origin of the standalone maps app the map tile's "Open the full map" link
# points at (src/lib/env.ts tryReadMapsUrl). Optional. Unset or empty means
# the hosted site, https://maps.spellkave.com (the hosted build sets nothing).
# Set an http(s) origin for a local Maps app. Set `off` to show no link and
# name no site; use that for local play, because the hosted maps app does not
# show a locally staged world. A value that is not an http(s) URL also means
# no link.
VITE_SPELLKAVE_MAPS_URL=

# WorkOS AuthKit public SPA client (no secret). Never put WORKOS_API_KEY here.
# Unset client id or issuer ⇒ the app fails closed ("the way into this world is
# closed"); there is NO built-in default issuer. Same values as apps/website.
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_ISSUER=https://<tenant>.authkit.app
# VITE_SPELLKAVE_LOGIN_ORIGIN=http://127.0.0.1:18081  # login site for sign-out; no default; required for every non-dev build

# Hosted OpenObserve RUM. Both values are public browser configuration, not
# secrets; use only a token created under OpenObserve Ingestion → RUM. The
# production workflow supplies the commit SHA as VITE_SPELLKAVE_RUM_VERSION.
# Missing any value keeps hosted RUM off. Local diagnostics use just play-rum-local.
VITE_SPELLKAVE_RUM_APPLICATION_ID=
VITE_SPELLKAVE_RUM_CLIENT_TOKEN=
# Optional session sample percent (0–100). Unset ⇒ 100 during beta; the
# production workflow reads repo variable SPELLKAVE_RUM_SESSION_SAMPLE_RATE.
VITE_SPELLKAVE_RUM_SESSION_SAMPLE_RATE=

# ---------------------------------------------------------------------------
# DEV-only local play. Ignored by any production build (vite.config.ts skips it
# when mode === "production"). See src/lib/dev-local.ts.
#
# Point this at the profile TOML that `just play-stage <adventure>` writes; it
# already carries the node url, the module, the staged hero and its credential.
# Easiest path: `just play-dev-local kavemouth`, which sets this for you.
#
# SPELLKAVE_DEV_PROFILE=~/.config/spellkave/profiles/kavemouth-candidate.toml
#
# Optional overrides — both default to the credential directory name:
# SPELLKAVE_DEV_SLUG=kavemouth
# SPELLKAVE_DEV_WORLD_NAME=Kavemouth
# SDK connect-time shape check: empty/strict refuses a world module whose row
# or reducer shapes break this build's kernel contract; `warn` connects, logs
# and reports each mismatch to RUM. Hosted builds set it in app.toml.
VITE_SPELLKAVE_SHAPE_CHECK=
