#!/usr/bin/env bash
# Pack the design system packages from an sk-sites checkout into .tarballs/.
# Stopgap until sk-sites publishes them to npm; then drop the overrides in
# pnpm-workspace.yaml and this script.
#
# Usage: scripts/pack-design-system [path-to-sk-sites]   (default ../sk-sites)
# The sk-sites checkout is cloned to a temp dir first and left unchanged.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
src="$(cd "${1:-$root/../sk-sites}" && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

git clone -q "$src" "$work/sk-sites"
echo "sk-sites $(git -C "$work/sk-sites" rev-parse HEAD)"
(cd "$work/sk-sites" && pnpm install --frozen-lockfile >/dev/null)

# Unpack each tarball into .tarballs/<pkg>/: the apps see exactly the packed
# files, as from npm. A directory, not the .tgz, because pnpm pack output
# differs between platforms and the lockfile would pin a checksum.
rm -rf "$root/.tarballs"
mkdir -p "$root/.tarballs" "$work/out"
for p in ui ui-widgets authkit map-canvas run-events-view; do
	(cd "$work/sk-sites/packages/spellkave-$p" && pnpm pack --pack-destination "$work/out" >/dev/null)
	mkdir "$root/.tarballs/$p"
	tar -xzf "$work/out"/spellkave-"$p"-[0-9]*.tgz -C "$root/.tarballs/$p" --strip-components=1
done
ls "$root/.tarballs"
